# server
LISTEN_HOST=0.0.0.0
LISTEN_PORT=4400
LISTEN_GRPC_PORT=4410
PUBLIC_HOST=localhost
PUBLIC_PORT=4410

# urls
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pleiades-master?schema=public

# identity
NODE_ID_PATH=data/node-id

# byte storage
BYTE_STORAGE_ROOT_PATH=data/byte-storage

# user authentication
USER_JWT_SECRET=replace-with-a-secure-random-secret
USER_JWT_TTL=30m
USER_API_KEY_HASH_SECRET=replace-with-a-secure-random-secret
USER_REFRESH_TOKEN_HASH_SECRET=replace-with-a-secure-random-secret

# admin authentication 
ADMIN_JWT_SECRET=replace-with-a-secure-random-secret

# grpc mtls
GRPC_CA_CERT_PATH=/path/to/ca-certificate.pem
GRPC_CERT_PATH=/path/to/master-node-certificate.pem
GRPC_PRIVATE_KEY_PATH=/path/to/master-node-private-key.pem
