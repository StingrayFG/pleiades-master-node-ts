{
  "name": "fastify-boilerplate-v3",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon -e ts,json,env --exec ts-node --files -r tsconfig-paths/register -r dotenv/config src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node -r dotenv/config src/index.js",
    "test": "LOG_LEVEL=error node -r ts-node/register -r tsconfig-paths/register --test src/**/*.test.ts",
    "prepare": "npx ts-patch install -s",
    "lint": "eslint",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/qs": "^6.15.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jiti": "^2.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-patch": "^4.0.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "typescript-transform-paths": "^4.0.0"
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/redis": "^8.0.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "axios": "^1.18.1",
    "fastify": "^5.10.0",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "qs": "^6.15.3",
    "zod": "^4.4.3"
  }
}
