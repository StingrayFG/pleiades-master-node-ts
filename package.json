{
  "name": "pleiades-master-node-ts",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon -e ts,json,env --exec ts-node --files -r tsconfig-paths/register -r dotenv/config src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node -r dotenv/config src/index.js",
    "test": "LOG_LEVEL=error jest",
    "prepare": "npx ts-patch install -s",
    "lint": "eslint",
    "proto:generate": "buf dep update && buf generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/qs": "^6.15.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jest": "^30.5.2",
    "jiti": "^2.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-patch": "^4.0.1",
    "ts-proto": "^2.12.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "typescript-transform-paths": "^4.0.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.1",
    "@fastify/autoload": "^6.5.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.1",
    "@grpc/grpc-js": "^1.14.4",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "argon2": "^0.45.1",
    "axios": "^1.18.1",
    "fastify": "^5.10.0",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "qs": "^6.15.3",
    "zod": "^4.4.3"
  }
}
