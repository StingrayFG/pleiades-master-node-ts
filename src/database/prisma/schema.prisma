generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// users and authentication

enum UserState {
  active
  disabled
}

model User {
  // identity
  id String @id @default(uuid())

  // authentication
  username      String @unique
  password_hash String

  // lifecycle
  state UserState @default(active)

  // relations
  api_keys       UserApiKey[]
  refresh_tokens UserRefreshToken[]
  buckets        Bucket[]

  // timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // database metadata
  @@map("users")
}

enum UserApiKeyState {
  active
  revoked
}

model UserApiKey {
  // identity
  id String @id @default(uuid())

  // ownership
  user_id String

  // authentication
  secret_hash String

  // lifecycle
  state UserApiKeyState @default(active)

  // metadata
  name String

  // relations
  user User @relation(fields: [user_id], references: [id])

  // timestamps
  created_at   DateTime  @default(now())
  expires_at   DateTime?
  last_used_at DateTime?
  revoked_at   DateTime?

  // database metadata
  @@index([user_id])
  @@map("user_api_keys")
}

enum UserRefreshTokenState {
  active
  revoked
}

model UserRefreshToken {
  // identity
  id String @id @default(uuid())

  // ownership
  user_id String

  // authentication
  secret_hash String

  // lifecycle
  state UserRefreshTokenState @default(active)

  // relations
  user User @relation(fields: [user_id], references: [id])

  // timestamps
  created_at DateTime  @default(now())
  expires_at DateTime
  revoked_at DateTime?

  // database metadata
  @@index([user_id])
  @@map("user_refresh_tokens")
}

// buckets and object storage

enum BucketState {
  active
  deleting
  disabled
}

model Bucket {
  // identity
  id   String @id @default(uuid())
  name String

  // ownership
  user_id String

  // lifecycle
  state BucketState @default(active)

  // relations
  user    User     @relation(fields: [user_id], references: [id])
  objects Object[]

  // timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // concurrency
  revision BigInt @default(0)

  // database metadata
  @@unique([user_id, name])
  @@map("buckets")
}

model Object {
  // identity
  id  String @id @default(uuid())
  key String

  // ownership
  bucket_id String

  // version
  current_version        Int?
  last_allocated_version Int  @default(0)

  // relations
  bucket   Bucket          @relation(fields: [bucket_id], references: [id])
  versions ObjectVersion[]

  // timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // database metadata
  @@unique([bucket_id, key])
  @@map("objects")
}

enum ObjectVersionState {
  pending
  committed
  deleting
}

model ObjectVersion {
  // identity
  object_id String
  version   Int

  // lifecycle
  state ObjectVersionState @default(pending)

  // metadata
  total_size_bytes BigInt
  content_type     String

  // relations
  object Object              @relation(fields: [object_id], references: [id])
  parts  ObjectVersionPart[]

  // timestamps
  created_at   DateTime  @default(now())
  committed_at DateTime?
  updated_at   DateTime  @updatedAt

  // database metadata
  @@id([object_id, version])
  @@index([state, updated_at])
  @@map("object_versions")
}

model ObjectVersionPart {
  // identity
  object_id   String
  version     Int
  part_number Int
  blob_id     String @id @default(uuid())

  // placement
  placement_group Int

  // metadata
  size_bytes         BigInt
  checksum_algorithm String
  checksum_value     String

  // relations
  object_version ObjectVersion              @relation(fields: [object_id, version], references: [object_id, version])
  replicas       ObjectVersionPartReplica[]

  // timestamps
  created_at DateTime @default(now())

  // database metadata
  @@unique([object_id, version, part_number])
  @@map("object_version_parts")
}

enum ObjectVersionPartReplicaState {
  pending
  committed
  deleting
  corrupt
  missing

  @@map("BlobReplicaState")
}

model ObjectVersionPartReplica {
  // identity
  blob_id      String
  data_node_id String

  // lifecycle
  state ObjectVersionPartReplicaState @default(pending)

  // relations
  object_version_part ObjectVersionPart @relation(fields: [blob_id], references: [blob_id])
  data_node           DataNode          @relation(fields: [data_node_id], references: [id])

  // timestamps
  created_at       DateTime  @default(now())
  last_verified_at DateTime?
  state_changed_at DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  // database metadata
  @@id([blob_id, data_node_id])
  @@index([data_node_id, state])
  @@index([state, last_verified_at])
  @@index([state, updated_at])
  @@map("replicas")
}

// byte storage

enum ByteStorageChecksumAlgorithm {
  sha256
}

enum ByteStorageObjectState {
  pending
  active
  deleting
}

model ByteStorageObject {
  // identity
  id String @id

  // metadata
  size_bytes         BigInt
  checksum           String
  checksum_algorithm ByteStorageChecksumAlgorithm

  // lifecycle
  state ByteStorageObjectState @default(pending)

  // timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // database metadata
  @@index([state])
  @@index([created_at])
  @@map("byte_storage_objects")
}

// tasks

enum TaskState {
  pending
  completed
  partially_completed
  failed
}

enum TaskExecutionScope {
  local
  cluster
}

enum TaskExecutionState {
  pending
  executing
  completed
  failed
}

model Task {
  // identity
  id String @id @default(uuid())

  // origin and order
  origin_master_id String
  epoch            BigInt
  sequence         BigInt

  // definition
  type            String
  data            Json
  execution_scope TaskExecutionScope

  // lifecycle
  state TaskState @default(pending)

  // relations
  origin_master MasterNode      @relation(fields: [origin_master_id], references: [id])
  executions    TaskExecution[]

  // timestamps
  // assigned by task creation flow for cluster consistency
  created_at DateTime
  updated_at DateTime

  // concurrency
  revision BigInt @default(0)

  // database metadata
  @@unique([epoch, sequence])
  @@index([origin_master_id])
  @@index([type])
  @@index([state])
  @@map("tasks")
}

model TaskExecution {
  // identity
  id String @id @default(uuid())

  // ownership
  task_id String

  // target
  target_master_id String

  // lifecycle
  state          TaskExecutionState @default(pending)
  failure_reason String?

  // relations
  task          Task       @relation(fields: [task_id], references: [id])
  target_master MasterNode @relation(fields: [target_master_id], references: [id])

  // timestamps
  created_at   DateTime
  started_at   DateTime?
  completed_at DateTime?
  updated_at   DateTime

  // concurrency
  revision BigInt @default(0)

  // database metadata
  @@index([task_id])
  @@index([target_master_id])
  @@index([state])
  @@map("task_executions")
}

// cluster and nodes

enum DataNodeState {
  joining
  active
  offline
  failed
}

enum DataNodeMode {
  serving
  draining
}

model DataNode {
  // identity
  id String @id

  // lifecycle
  certificate_fingerprint String        @unique
  session_id              String
  last_heartbeat_sequence BigInt        @default(0)
  state                   DataNodeState @default(joining)
  mode                    DataNodeMode  @default(serving)

  // connection metadata
  hostname String
  port     Int
  scheme   String @default("grpcs")

  // storage metadata
  storage_total_bytes BigInt
  storage_free_bytes  BigInt

  // relations
  replicas ObjectVersionPartReplica[]

  // timestamps
  registered_at        DateTime  @default(now())
  last_contact_at      DateTime
  last_heartbeat_at    DateTime?
  last_health_check_at DateTime?
  updated_at           DateTime  @updatedAt

  // concurrency
  revision BigInt @default(0)

  // database metadata
  @@index([state])
  @@index([last_heartbeat_at])
  @@map("data_nodes")
}

enum MasterNodeState {
  joining
  active
  offline
  failed
}

enum MasterNodeMode {
  serving
  draining
}

model MasterNode {
  // identity
  id String @id

  // lifecycle
  certificate_fingerprint String          @unique
  session_id              String
  state                   MasterNodeState @default(joining)
  mode                    MasterNodeMode  @default(serving)

  // connection metadata
  hostname String
  port     Int
  scheme   String @default("grpcs")

  // relations
  tasks           Task[]
  task_executions TaskExecution[]

  // timestamps
  registered_at        DateTime  @default(now())
  last_contact_at      DateTime
  last_health_check_at DateTime?
  last_heartbeat_at    DateTime?
  updated_at           DateTime  @updatedAt

  // concurrency
  revision BigInt @default(0)

  // database metadata
  @@map("master_nodes")
}

// consensus

model ConsensusState {
  // identity
  id String @id

  // consensus
  current_epoch           BigInt  @default(0)
  leader_master_id        String?
  last_allocated_sequence BigInt  @default(-1)
  last_committed_sequence BigInt  @default(-1)
  last_applied_sequence   BigInt  @default(-1)

  // timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // concurrency
  revision BigInt @default(0)

  // database metadata
  @@map("consensus_state")
}
