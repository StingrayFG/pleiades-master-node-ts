generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
}


enum BucketState {
  active
  deleting
  disabled
}

model Bucket {
  id                Int                     @id @default(autoincrement())
  name              String                  @unique
  state             BucketState             @default(active)
  created_at        DateTime                @default(now())
  updated_at        DateTime                @updatedAt

  objects           Object[]

  @@map("buckets")
}